# ============================================================
# CRYPTOMIND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ============================================================

# ------------------------------------------------------------
# 1. REQUIRED PRODUCTION VARIABLES
# ------------------------------------------------------------
# Neon PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# AI & LLM Provider API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
HF_TOKEN=hf_your_huggingface_access_token_here
PINECONE_API_KEY=pcsk_your_pinecone_vector_db_key_here

# ------------------------------------------------------------
# 2. OPTIONAL INTEGRATIONS & UPGRADES
# ------------------------------------------------------------
# CoinGecko Pro API Key (Optional; defaults to free public tier)
COINGECKO_API_KEY=your_coingecko_api_key_here

# ------------------------------------------------------------
# 3. ENVIRONMENT & OBSERVABILITY
# ------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 4. SECURITY & CORS SETTINGS
# ------------------------------------------------------------
# Comma-separated list of allowed frontend origins (No wildcard '*' allowed when credentials are enabled)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Rate Limiting (Max requests per minute per IP)
GENERAL_RATE_LIMIT=60
RESEARCH_RATE_LIMIT=10

# Request Boundaries & Timeouts
HTTP_TIMEOUT_SECONDS=15.0
MAX_RESEARCH_QUERY_LENGTH=1000

# ------------------------------------------------------------
# 5. DATABASE POOLING SETTINGS
# ------------------------------------------------------------
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------------
# 6. INGESTION WORKER & SCHEDULER SETTINGS
# ------------------------------------------------------------
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_RUN_ON_STARTUP=false

# ------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
